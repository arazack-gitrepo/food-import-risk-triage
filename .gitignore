# Data: not redistributed. Download from the RASFF Window portal.
data/*
!data/.gitkeep

# Generated by run_experiment.py. Never committed: if it is in the repo,
# someone will eventually read a stale number out of it.
results/*
!results/.gitkeep

# Exception: the dashboard needs three files to run, and making a marker
# regenerate them just to open the app is a waste of their time. These are the
# only generated files in the repo. Every number on screen comes from them, and
# the model card records which estimator and tier the saved model holds, so a
# mismatch is caught at load instead of scoring silently against the wrong
# thing. Nothing else in results/ is committed.
!results/models/
results/models/*
!results/models/deployment_model.joblib
!results/models/deployment_model_card.json
!results/predictions/
results/predictions/*
!results/predictions/test_window.csv

# Model artefacts are regenerated, never stored. A committed .joblib is how a
# LightGBM file ends up loaded where a random forest was expected. The one
# exception is the deployment model above, which ships with its card.
*.joblib
*.pkl
!results/models/deployment_model.joblib

.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
.DS_Store
.vscode/
.idea/
